# Force LF line endings for everything that might run as a script or be
# fetched raw (e.g. `bash <(curl -Ls .../install.sh)`) regardless of the
# committer's local git config -- a CRLF shebang line breaks `bash`
# outright, so this is not just cosmetic.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.sudoers text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary
*.ico binary
